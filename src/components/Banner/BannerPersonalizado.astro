---
import { SITE_CONFIG } from "../../config/site.ts";
import "./banner.css";

const mensagem = encodeURIComponent(
    "Olá! Gostaria de conversar sobre uma encomenda personalizada.",
);
const link = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${mensagem}`;
---

<aside class="custom-order" aria-labelledby="custom-order-title">
    <div>
        <p class="custom-order-eyebrow">Feito especialmente para você</p>
        <h2 id="custom-order-title">Tem uma ideia diferente?</h2>
        <p>
            Converse sobre cores, medidas e detalhes para criar uma peça
            personalizada.
        </p>
    </div>
    <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="custom-order-button"
    >
        Pedir orçamento pelo WhatsApp
    </a>
</aside>
