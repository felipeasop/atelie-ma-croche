---
import type { Produto } from "../../catalogo/tipos.ts";
import {
    CATEGORIAS_INFO,
    produtoTemVariantes,
} from "../../catalogo/tipos.ts";
import {
    caminhoImagem,
    criarLinkWhatsApp,
    precoExibicao,
    resumoProduto,
} from "../../catalogo/produto.ts";
import { SITE_CONFIG } from "../../config/site.ts";
import "./card.css";

interface Props {
    produto: Produto;
    prioridade?: boolean;
}

const { produto, prioridade = false } = Astro.props;
const categoria = CATEGORIAS_INFO[produto.categoria];
const capa = produto.imagens[0];
const resumo = resumoProduto(produto);
const temVariasFotos = produto.imagens.length > 1;
const temVariantes = produtoTemVariantes(produto);
const idTitulo = `produto-${produto.categoria}-${produto.slug}`;
const linkWhatsApp = temVariantes
    ? null
    : criarLinkWhatsApp(produto, SITE_CONFIG.whatsapp);
---

<article class="card" aria-labelledby={idTitulo}>
    <button
        type="button"
        class="card-main"
        data-open-product={produto.id}
        aria-label={`Ver fotos e detalhes de ${produto.nome}`}
    >
        <span class="card-img-wrap">
            <img
                src={caminhoImagem(capa)}
                alt={`Foto de ${produto.nome}`}
                class="card-img"
                loading={prioridade ? "eager" : "lazy"}
                fetchpriority={prioridade ? "high" : "auto"}
                decoding="async"
            />

            {
                temVariasFotos && (
                    <span
                        class="card-foto-count"
                        aria-label={`${produto.imagens.length} fotos disponíveis`}
                    >
                        <span aria-hidden="true">▧</span>
                        {produto.imagens.length}
                    </span>
                )
            }

            {
                produto.sobMedida && (
                    <span class="badge badge-sob-medida">Sob medida</span>
                )
            }
        </span>

        <span class="card-content">
            <span class="card-cat">{categoria.nome}</span>
            <span class="card-name" id={idTitulo}>{produto.nome}</span>
            {produto.descricao && <span class="card-desc">{produto.descricao}</span>}
            {resumo && <span class="card-summary">{resumo}</span>}
        </span>
    </button>

    <footer class="card-footer">
        <span class="card-price">{precoExibicao(produto)}</span>
        {
            linkWhatsApp ? (
                <a
                    class="btn-order"
                    href={linkWhatsApp}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Encomendar ${produto.nome} pelo WhatsApp`}
                >
                    Encomendar
                </a>
            ) : (
                <button
                    type="button"
                    class="btn-order"
                    data-open-product={produto.id}
                    aria-label={`Ver opções de ${produto.nome}`}
                >
                    Ver opções
                </button>
            )
        }
    </footer>
</article>
