---
import { caminhoPublico } from "../catalogo/produto.ts";
import { SITE_CONFIG } from "../config/site.ts";
import "../styles/main.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = SITE_CONFIG.titulo,
    description = SITE_CONFIG.descricao,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemSocial = new URL(caminhoPublico("imagens/logo.png"), Astro.site);
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f8f3ec" />

        <meta property="og:locale" content="pt_BR" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_CONFIG.nome} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={imagemSocial} />

        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href={caminhoPublico("favicon.svg")} />
        <link rel="icon" href={caminhoPublico("favicon.ico")} sizes="any" />
        <title>{title}</title>

        <script is:inline>
            (() => {
                try {
                    const salvo = localStorage.getItem("atelie-tema");
                    const prefereEscuro = matchMedia("(prefers-color-scheme: dark)").matches;
                    document.documentElement.dataset.theme =
                        salvo === "dark" || salvo === "light"
                            ? salvo
                            : prefereEscuro
                              ? "dark"
                              : "light";
                } catch {
                    document.documentElement.dataset.theme = "light";
                }
            })();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#conteudo-principal">Ir para o catálogo</a>
        <slot />
        <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label="Usar tema escuro"
        >
            <span data-theme-icon aria-hidden="true">🌙</span>
        </button>
    </body>
</html>
