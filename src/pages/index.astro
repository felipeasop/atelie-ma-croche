---
import BannerPersonalizado from "../components/Banner/BannerPersonalizado.astro";
import Modal from "../components/Modal/Modal.astro";
import ProductCard from "../components/ProductCard/ProductCard.astro";
import Layout from "../layouts/Layout.astro";
import { carregarProdutos } from "../catalogo/carregar.ts";
import {
    CATEGORIAS_INFO,
    CATEGORIAS_ORDEM,
} from "../catalogo/tipos.ts";
import { caminhoPublico } from "../catalogo/produto.ts";
import { SITE_CONFIG } from "../config/site.ts";

const produtos = await carregarProdutos();
const categorias = CATEGORIAS_ORDEM.map((id) => ({
    id,
    ...CATEGORIAS_INFO[id],
    produtos: produtos.filter((produto) => produto.categoria === id),
})).filter((categoria) => categoria.produtos.length > 0);

const dadosCliente = JSON.stringify({
    produtos,
    whatsapp: SITE_CONFIG.whatsapp,
}).replaceAll("<", "\\u003c");
---

<Layout>
    <header class="hero">
        <img
            src={caminhoPublico("imagens/logo.png")}
            alt=""
            class="hero-logo"
            width="112"
            height="112"
        />
        <p class="hero-eyebrow">Catálogo artesanal</p>
        <h1>Ateliê <em>Ma</em> Crochê</h1>
        <p class="hero-description">
            Peças feitas à mão, com cores personalizáveis e encomendas
            combinadas diretamente pelo WhatsApp.
        </p>
    </header>

    <nav class="category-nav" aria-label="Categorias do catálogo">
        <div class="category-nav-inner">
            {
                categorias.map((categoria) => (
                    <a
                        href={`#categoria-${categoria.id}`}
                        class="category-link"
                        data-category-link
                    >
                        <span aria-hidden="true">{categoria.icone}</span>
                        {categoria.nome}
                    </a>
                ))
            }
        </div>
    </nav>

    <main id="conteudo-principal">
        <div class="catalog">
            {
                categorias.map((categoria, categoriaIndice) => (
                    <section
                        class="category-section"
                        id={`categoria-${categoria.id}`}
                        aria-labelledby={`titulo-${categoria.id}`}
                        data-category-section
                    >
                        <header class="category-header">
                            <span class="category-icon" aria-hidden="true">
                                {categoria.icone}
                            </span>
                            <div>
                                <h2 id={`titulo-${categoria.id}`}>
                                    {categoria.nome}
                                </h2>
                                <p>
                                    {categoria.produtos.length === 1
                                        ? "1 modelo disponível"
                                        : `${categoria.produtos.length} modelos disponíveis`}
                                </p>
                            </div>
                        </header>

                        <div class="product-grid">
                            {categoria.produtos.map((produto, produtoIndice) => (
                                <ProductCard
                                    produto={produto}
                                    prioridade={categoriaIndice === 0 && produtoIndice === 0}
                                />
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>

        <BannerPersonalizado />
    </main>

    <footer class="site-footer">
        <p class="footer-name">{SITE_CONFIG.nome}</p>
        <p>Todas as peças são feitas à mão com muito carinho.</p>
        <a
            href={`https://instagram.com/${SITE_CONFIG.instagram}`}
            target="_blank"
            rel="noopener noreferrer"
        >
            @{SITE_CONFIG.instagram}
        </a>
    </footer>

    <Modal />

    <script
        id="catalog-data"
        type="application/json"
        set:html={dadosCliente}
    ></script>

    <script>
        import { iniciarCatalogo } from "../scripts/catalog.ts";
        iniciarCatalogo();
    </script>
</Layout>
